{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Workers Builds の deploy / preview 前に OpenNext のビルドを走らせる
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "name": "campus-ar-client",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "campus-ar-client"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // PR ブランチのビルドは wrangler preview で動くため、Preview 用のバインディングを別に書く
  "previews": {
    "images": {
      "binding": "IMAGES"
    }
  }
}
